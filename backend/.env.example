# AlignCV backend configuration. Copy to .env and adjust as needed.
ALIGNCV_ENVIRONMENT=development
ALIGNCV_DEBUG=false

# Comma-separated list of allowed frontend origins.
ALIGNCV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload and fetch limits.
ALIGNCV_MAX_UPLOAD_BYTES=10485760
ALIGNCV_JOB_FETCH_TIMEOUT_SECONDS=15
ALIGNCV_JOB_FETCH_MAX_BYTES=2097152
ALIGNCV_JOB_FETCH_MAX_REDIRECTS=3

# LaTeX compilation limits.
ALIGNCV_LATEX_TIMEOUT_SECONDS=30
ALIGNCV_LATEX_MAX_SOURCE_BYTES=524288

# Short-lived in-memory artifact retention (seconds).
ALIGNCV_ARTIFACT_TTL_SECONDS=3600

# Semantic matching model (used only when the optional backend is installed).
ALIGNCV_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Playwright fallback is opt-in and requires a separate installation.
ALIGNCV_ENABLE_PLAYWRIGHT=false
